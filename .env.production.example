APP_URL=https://photos.example.com
FENJALBUM_BIND_ADDRESS=127.0.0.1
FENJALBUM_PORT=3300
FENJALBUM_STORAGE_ROOT=./storage
FENJALBUM_IMPORT_ROOT=./import
DATABASE_URL=postgresql://fenjalbum:REPLACE_DATABASE_PASSWORD@db:5432/fenjalbum?schema=public
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
ADMIN_NAME=Administrator
POSTGRES_DB=fenjalbum
POSTGRES_USER=fenjalbum
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
MEDIA_ROOT=/data/media
THUMB_ROOT=/data/thumbs
POSTER_ROOT=/data/posters
UPLOAD_TMP_ROOT=/data/tmp
MAX_UPLOAD_MB=4096
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_UPLOAD_MAX=600
FFMPEG_THREADS=2
FFMPEG_PRESET=veryfast
TRUST_PROXY=true
SEED_DEMO=false
WORKER_POLL_MS=2500
