{
  "name": "fenjalbum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev": "docker compose -f docker-compose.dev.yml up -d",
    "db:dev:stop": "docker compose -f docker-compose.dev.yml stop",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate:local": "tsx scripts/prisma-local.ts migrate dev",
    "prisma:deploy:local": "tsx scripts/prisma-local.ts migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "import": "tsx scripts/import.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "file-type": "^22.1.1",
    "jose": "^5.6.3",
    "lucide-react": "^0.539.0",
    "nanoid": "^5.1.5",
    "next": "^16.3.8",
    "prisma": "^6.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-filename": "^1.6.3",
    "sharp": "^0.35.5",
    "tsx": "^4.20.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/sanitize-filename": "^1.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
